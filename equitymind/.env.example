# ---- Model access (pick one) ----------------------------------------------
# Option A: Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here

# Option B: Vertex AI (comment out Option A)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- EquityMind (all optional) --------------------------------------------
# EQUITYMIND_MODEL=gemini-2.5-flash
# EQUITYMIND_SENTIMENT_MODEL=gemini-2.5-flash
# EQUITYMIND_CACHE_TTL_S=300
# EQUITYMIND_HISTORY_LIMIT=20
# EQUITYMIND_LOG_LEVEL=INFO
# EQUITYMIND_LOG_JSON=true
# EQUITYMIND_SESSION_URI=sqlite+aiosqlite:///./data/sessions.db
# EQUITYMIND_TRACE_TO_CLOUD=false
# EQUITYMIND_SERVE_WEB_UI=true
# EQUITYMIND_ALLOWED_ORIGINS=*
